// ============================================================
// TOKO-WANTECH PRISMA SCHEMA
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GLOBAL TABLES
// ============================================================

model Region {
  code          String   @id @db.Char(4)
  provinceCode  String   @map("province_code") @db.Char(2)
  regencyCode   String   @map("regency_code") @db.Char(2)
  provinceName  String   @map("province_name") @db.VarChar(100)
  regencyName   String   @map("regency_name") @db.VarChar(100)
  fullName      String   @map("full_name") @db.VarChar(200)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("regions")
}

model Niche {
  code        String     @id @db.Char(2)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  icon        String?    @default("🏪") @db.VarChar(50)
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenants   Tenant[]
  subTypes  SubType[]

  @@map("niches")
}

model SubType {
  id          String   @id @db.Char(36)
  code        String   @db.Char(2)
  nicheCode   String   @map("niche_code") @db.Char(2)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @default("📦") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  niche Niche @relation(fields: [nicheCode], references: [code], onDelete: Cascade)

  @@unique([nicheCode, code])
  @@index([nicheCode])
  @@map("sub_types")
}

model Customer {
  id                String    @id @db.Char(36)
  telegramId        BigInt    @unique @map("telegram_id")
  telegramUsername  String?   @map("telegram_username") @db.VarChar(100)
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  totalTransactions Int       @default(0) @map("total_transactions")
  totalSpent 	    Int       @default(0) @map("total_spent") @db.UnsignedInt
  loyaltyPoints     Int       @default(0) @map("loyalty_points") @db.UnsignedInt
  joinedChannel     Boolean   @default(false) @map("joined_channel")
  lastActiveAt      DateTime? @map("last_active_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  transactions Transaction[]
  vouchers     Voucher[]

  @@index([phone])
  @@index([lastActiveAt])
  @@map("customers")
}

model SubscriptionPlan {
  id              String   @id @db.Char(36)
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(50)
  priceMonthly    Int      @map("price_monthly") @db.UnsignedInt
  priceYearly     Int      @map("price_yearly") @db.UnsignedInt
  maxTransactions Int      @default(-1) @map("max_transactions")
  maxProducts     Int      @default(-1) @map("max_products")
  maxUsers        Int      @default(1) @map("max_users")
  maxWarungs      Int      @default(1) @map("max_warungs")
  storageMb       Int      @default(1000) @map("storage_mb")
  features        Json
  isActive        Boolean  @default(true) @map("is_active")
  isPopular       Boolean  @default(false) @map("is_popular")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([isActive])
  @@map("subscription_plans")
}

// ============================================================
// TENANT TABLES (Multi-tenant)
// ============================================================

model Tenant {
  // WIC = Primary Key (15 digit)
  wic                         String   @id @db.Char(15)
  slug                        String   @unique @db.VarChar(100)
  name                        String   @db.VarChar(200)
  
  // Denormalized dari WIC
  nicheCode                   String   @map("niche_code") @db.Char(2)
  subTypeCode                 String   @map("sub_type_code") @db.Char(2)
  regionCode                  String   @map("region_code") @db.Char(4)
  joinYear                    Int      @map("join_year") @db.SmallInt
  sequence                    Int
  
  // Branding
  logoUrl                     String?  @map("logo_url") @db.VarChar(500)
  faviconBase64               String?  @map("favicon_base64") @db.Text
  primaryColor                String?  @default("#16A34A") @map("primary_color") @db.VarChar(7)
  secondaryColor              String?  @default("#FACC15") @map("secondary_color") @db.VarChar(7)
  tagline                     String?  @db.VarChar(200)
  
  // Bot config
  botType                     String   @default("shared") @map("bot_type") @db.VarChar(20)
  telegramBotTokenEncrypted   String?  @map("telegram_bot_token_encrypted") @db.Text
  telegramBotUsername         String?  @unique @map("telegram_bot_username") @db.VarChar(100)
  telegramChannelId           String?  @map("telegram_channel_id") @db.VarChar(100)
  webhookSecret               String?  @map("webhook_secret") @db.VarChar(100)
  
  // Domain
  customDomain                String?  @map("custom_domain") @db.VarChar(200)
  subdomain                   String?  @db.VarChar(100)
  
  // Contact
  address                     String?  @db.Text
  phone                       String?  @db.VarChar(20)
  email                       String?  @db.VarChar(200)
  
  // Payment
  qrisImageUrl                String?  @map("qris_image_url") @db.VarChar(500)
  qrisNmim                    String?  @map("qris_nmim") @db.VarChar(100)
  bankAccounts                Json?    @map("bank_accounts")
  
  // Metadata
  metadata                    Json?
  
  // Status
  status                      String   @default("active") @db.VarChar(20)
  plan                        String   @default("mikro") @db.VarChar(20)
  trialEndsAt                 DateTime? @map("trial_ends_at")
  
  // Timestamps
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  
  // Relations
  region              Region              @relation(fields: [regionCode], references: [code])
  niche               Niche               @relation(fields: [nicheCode], references: [code])
  users               TenantUser[]
  warungs             Warung[]
  categories          Category[]
  products            Product[]
  transactions        Transaction[]
  promos              Promo[]
  botTokenMappings    BotTokenMapping[]
  subscription        Subscription?
  invoices            Invoice[]
  landingPage         TenantLandingPage?
  assets              TenantAsset[]
  dailySales          DailySale[]
  auditLogs           AuditLog[]
  
  @@index([nicheCode])
  @@index([regionCode])
  @@index([joinYear])
  @@index([status])
  @@index([plan])
  @@index([subdomain])
  @@map("tenants")
}

model TenantUser {
  id               String    @id @db.Char(36)
  tenantId         String    @map("tenant_id") @db.Char(15)
  role             String    @db.VarChar(30)
  name             String    @db.VarChar(200)
  email            String?   @unique @db.VarChar(200)
  phone            String?   @db.VarChar(20)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  telegramId       BigInt?   @unique @map("telegram_id")
  telegramUsername String?   @map("telegram_username") @db.VarChar(100)
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  tenant       Tenant      @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  ownedWarungs Warung[]
  
  @@index([tenantId])
  @@index([role])
  @@map("tenant_users")
}

model Warung {
  id               String   @id @db.Char(36)
  tenantId         String   @map("tenant_id") @db.Char(15)
  ownerUserId      String?  @map("owner_user_id") @db.Char(36)
  name             String   @db.VarChar(200)
  slug             String   @db.VarChar(100)
  description      String?  @db.Text
  address          String?  @db.Text
  phone            String?  @db.VarChar(20)
  operatingHours   Json?    @map("operating_hours")
  qrCodeUrl        String?  @map("qr_code_url") @db.VarChar(500)
  qrCodePayload    String?  @map("qr_code_payload") @db.VarChar(200)
  qrisImageUrl     String?  @map("qris_image_url") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  isVerified       Boolean  @default(false) @map("is_verified")
  totalTransactions Int     @default(0) @map("total_transactions") @db.UnsignedInt
  totalRevenue     BigInt   @default(0) @map("total_revenue") @db.UnsignedBigInt
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  
  tenant       Tenant        @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  owner        TenantUser?   @relation(fields: [ownerUserId], references: [id])
  products     Product[]
  transactions Transaction[]
  dailySales   DailySale[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerUserId])
  @@index([isActive])
  @@map("warungs")
}

model Category {
  id          String   @id @db.Char(36)
  tenantId    String   @map("tenant_id") @db.Char(15)
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  
  tenant   Tenant    @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  products Product[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                String   @id @db.Char(36)
  tenantId          String   @map("tenant_id") @db.Char(15)
  warungId          String?  @map("warung_id") @db.Char(36)
  categoryId        String?  @map("category_id") @db.Char(36)
  name              String   @db.VarChar(200)
  slug              String   @db.VarChar(100)
  description       String?  @db.Text
  price             Int      @db.UnsignedInt
  imageUrl          String?  @map("image_url") @db.VarChar(500)
  thumbnailUrl      String?  @map("thumbnail_url") @db.VarChar(500)
  stock             Int      @default(-1)
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  isAvailable       Boolean  @default(true) @map("is_available")
  isBestSeller      Boolean  @default(false) @map("is_best_seller")
  isFeatured        Boolean  @default(false) @map("is_featured")
  sortOrder         Int      @default(0) @map("sort_order")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  tenant           Tenant            @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  warung           Warung?           @relation(fields: [warungId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  transactionItems TransactionItem[]
  
  @@unique([tenantId, warungId, slug])
  @@index([tenantId])
  @@index([warungId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isBestSeller])
  @@map("products")
}

model Transaction {
  id               String    @id @db.Char(36)
  tenantId         String    @map("tenant_id") @db.Char(15)
  warungId         String?   @map("warung_id") @db.Char(36)
  customerId       String?   @map("customer_id") @db.Char(36)
  code             String    @unique @db.VarChar(50)
  items            Json
  subtotal         Int       @db.UnsignedInt
  discount         Int       @default(0) @db.UnsignedInt
  total            Int       @db.UnsignedInt
  paymentMethod    String    @default("QRIS") @map("payment_method") @db.VarChar(20)
  paymentProofUrl  String?   @map("payment_proof_url") @db.VarChar(500)
  status           String    @default("pending") @db.VarChar(20)
  verifiedBy       String?   @map("verified_by") @db.Char(36)
  verifiedAt       DateTime? @map("verified_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  voucherId        String?   @map("voucher_id") @db.Char(36)
  voucherCode      String?   @map("voucher_code") @db.VarChar(50)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  tenant    Tenant            @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  warung    Warung?           @relation(fields: [warungId], references: [id])
  customer  Customer?         @relation(fields: [customerId], references: [id])
  items_    TransactionItem[] @relation("TransactionItems")
  
  @@index([tenantId])
  @@index([warungId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("transactions")
}

model TransactionItem {
  id            String @id @db.Char(36)
  transactionId String @map("transaction_id") @db.Char(36)
  productId     String? @map("product_id") @db.Char(36)
  productName   String @map("product_name") @db.VarChar(200)
  price         Int    @db.UnsignedInt
  quantity      Int    @db.UnsignedInt
  subtotal      Int    @db.UnsignedInt
  
  transaction Transaction @relation("TransactionItems", fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])
  
  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model Promo {
  id          String    @id @db.Char(36)
  tenantId    String    @map("tenant_id") @db.Char(15)
  name        String    @db.VarChar(200)
  code        String    @unique @db.VarChar(50)
  type        String    @db.VarChar(30)
  value       Int       @db.UnsignedInt
  minPurchase Int       @default(0) @map("min_purchase") @db.UnsignedInt
  maxDiscount Int?      @map("max_discount") @db.UnsignedInt
  quota       Int       @default(-1)
  usedCount   Int       @default(0) @map("used_count") @db.UnsignedInt
  startsAt    DateTime  @map("starts_at")
  expiresAt   DateTime  @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  tenant   Tenant    @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  vouchers Voucher[]
  
  @@index([tenantId, isActive])
  @@index([expiresAt])
  @@map("promos")
}

model Voucher {
  id            String    @id @db.Char(36)
  promoId       String    @map("promo_id") @db.Char(36)
  customerId    String    @map("customer_id") @db.Char(36)
  code          String    @unique @db.VarChar(50)
  isUsed        Boolean   @default(false) @map("is_used")
  usedAt        DateTime? @map("used_at")
  transactionId String?   @map("transaction_id") @db.Char(36)
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  promo    Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@index([customerId, isUsed])
  @@index([expiresAt])
  @@map("vouchers")
}

model BotTokenMapping {
  id                          String   @id @db.Char(36)
  telegramBotTokenEncrypted   String   @map("telegram_bot_token_encrypted") @db.Text
  telegramBotUsername         String   @unique @map("telegram_bot_username") @db.VarChar(100)
  tenantId                    String   @map("tenant_id") @db.Char(15)
  botType                     String   @default("shared") @map("bot_type") @db.VarChar(20)
  isActive                    Boolean  @default(true) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  
  tenant Tenant @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  
  @@index([tenantId])
  @@map("bot_token_mapping")
}

model Subscription {
  id                  String    @id @db.Char(36)
  tenantId            String    @unique @map("tenant_id") @db.Char(15)
  planId              String    @map("plan_id") @db.Char(36)
  status              String    @default("trial") @db.VarChar(20)
  currentPeriodStart  DateTime  @map("current_period_start")
  currentPeriodEnd    DateTime  @map("current_period_end")
  trialStart          DateTime? @map("trial_start")
  trialEnd            DateTime? @map("trial_end")
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationReason  String?   @map("cancellation_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  tenant   Tenant             @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices Invoice[]
  
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id               String    @id @db.Char(36)
  tenantId         String    @map("tenant_id") @db.Char(15)
  subscriptionId   String    @map("subscription_id") @db.Char(36)
  invoiceNumber    String    @unique @map("invoice_number") @db.VarChar(50)
  planId           String    @map("plan_id") @db.Char(36)
  amount           Int       @db.UnsignedInt
  discount         Int       @default(0) @db.UnsignedInt
  total            Int       @db.UnsignedInt
  status           String    @default("pending") @db.VarChar(20)
  issuedAt         DateTime  @map("issued_at")
  dueDate          DateTime  @map("due_date")
  paidAt           DateTime? @map("paid_at")
  paymentMethod    String?   @map("payment_method") @db.VarChar(20)
  paymentProofUrl  String?   @map("payment_proof_url") @db.VarChar(500)
  pdfUrl           String?   @map("pdf_url") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  tenant       Tenant       @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan  @relation(fields:[planId], references:[id])
  
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model TenantLandingPage {
  id          String   @id @db.Char(36)
  tenantId    String   @unique @map("tenant_id") @db.Char(15)
  htmlContent String?  @map("html_content") @db.LongText
  cssCustom   String?  @map("css_custom") @db.LongText
  pageConfig  Json?    @map("page_config")
  version     Int      @default(1) @db.UnsignedInt
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  tenant   Tenant                    @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  versions TenantLandingPageVersion[]
  
  @@map("tenant_landing_pages")
}

model TenantLandingPageVersion {
  id            String   @id @db.Char(36)
  landingPageId String   @map("landing_page_id") @db.Char(36)
  version       Int      @db.UnsignedInt
  htmlContent   String?  @map("html_content") @db.LongText
  cssCustom     String?  @map("css_custom") @db.LongText
  createdBy     String?  @map("created_by") @db.Char(36)
  changeNote    String?  @map("change_note") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  
  landingPage TenantLandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  
  @@index([landingPageId, version(sort: Desc)])
  @@map("tenant_landing_page_versions")
}

model TenantAsset {
  id            String   @id @db.Char(36)
  tenantId      String   @map("tenant_id") @db.Char(15)
  assetType     String   @map("asset_type") @db.VarChar(50)
  fileName      String?  @map("file_name") @db.VarChar(200)
  fileSize      Int?     @map("file_size") @db.UnsignedInt
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  storagePath   String   @map("storage_path") @db.VarChar(500)
  publicUrl     String?  @map("public_url") @db.VarChar(500)
  isPublic      Boolean  @default(false) @map("is_public")
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")
  
  tenant Tenant @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([assetType])
  @@index([referenceType, referenceId])
  @@map("tenant_assets")
}

model DailySale {
  id                 String   @id @db.Char(36)
  tenantId           String   @map("tenant_id") @db.Char(15)
  warungId           String?  @map("warung_id") @db.Char(36)
  saleDate           DateTime @map("sale_date") @db.Date
  totalSales         Int      @default(0) @map("total_sales") @db.UnsignedInt
  totalTransactions  Int      @default(0) @map("total_transactions") @db.UnsignedInt
  uniqueBuyers       Int      @default(0) @map("unique_buyers") @db.UnsignedInt
  avgTransaction     Int      @default(0) @map("avg_transaction") @db.UnsignedInt
  topProducts        Json?    @map("top_products")
  hourlyBreakdown    Json?    @map("hourly_breakdown")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  
  tenant Tenant @relation(fields: [tenantId], references: [wic], onDelete: Cascade)
  warung Warung? @relation(fields: [warungId], references: [id])
  
  @@unique([tenantId, warungId, saleDate])
  @@index([tenantId, saleDate(sort: Desc)])
  @@map("daily_sales")
}

model AuditLog {
  id         String   @id @db.Char(36)
  tenantId   String?  @map("tenant_id") @db.Char(15)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Char(36)
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  
  tenant Tenant? @relation(fields: [tenantId], references: [wic], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
